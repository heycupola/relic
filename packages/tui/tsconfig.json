{
  "extends": "@repo/typescript-config/bundler.json",
  "compilerOptions": {
    "paths": {
      "@repo/backend": ["../backend/index.ts"],
      "@repo/backend/*": ["../backend/*"],
      "@repo/auth": ["../auth/index.ts"],
      "@repo/auth/*": ["../auth/*"],
      "@repo/bulk-import": ["../bulk-import/index.ts"],
      "@repo/bulk-import/*": ["../bulk-import/*"],
      "@repo/crypto": ["../crypto/index.ts"],
      "@repo/crypto/*": ["../crypto/*"],
      "@repo/logger": ["../logger/index.ts"],
      "@repo/logger/*": ["../logger/*"]
    },
    "types": ["bun"],
    "jsxImportSource": "react"
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules"]
}
